node_modules/
*.log
.DS_Store
Thumbs.db
scratchpad/
*.output
.wrangler/
.dev.vars
.env
*.local
.claude/scheduled_tasks.lock

# audit intermediates — regenerable from the worklist, and noisy in diffs
data/_gf_audit_shards/

# Agent scratch space — fetched pages, working briefs, helper scripts.
# Never a deliverable. Subagents pick their own directory names, so this is a
# pattern rather than a list; two different ones got committed before it existed.
# Subagents choose their own scratch directory names — tmpwork/, .tmpx/,
# .scratch2a/ have all been committed by accident. Match broadly, and prefer
# explicit `git add <path>` over `git add -A` while agents are writing.
tmpwork/
.tmp*/
tmp_*/
*scratch*/
.scratch*
_work/

# agent scratch (each agent invents its own name)
.enrich_tmp/
scripts/_*.py

# incremental agent partials — only finished sN.json shards are inputs
data/_*_verdicts/_*_part_*.json

# runtime lock held by scripts/rebuild.mjs
data/.rebuild.lock

# per-rebuild tier-write diagnostic (see scripts/lib-tiers.mjs)
data/_tier_writes.jsonl
